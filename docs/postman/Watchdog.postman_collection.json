{
  "info": {
    "name": "Watchdog API",
    "description": "Every Watchdog endpoint, in the order you would use them. Set baseUrl in the environment (http://localhost:5000 locally, or your Render address). Run the folders top to bottom with the Collection Runner, or run the Auth requests first and then any request you like: Postman keeps the httpOnly session cookie for you. The collection stores monitorId, incidentId and slug automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "targetUrl",
      "value": "https://example.com"
    },
    {
      "key": "monitorId",
      "value": ""
    },
    {
      "key": "incidentId",
      "value": ""
    },
    {
      "key": "slug",
      "value": "my-status"
    },
    {
      "key": "email",
      "value": "postman@example.com"
    },
    {
      "key": "password",
      "value": "a-long-password-123"
    },
    {
      "key": "monitorUrl",
      "value": ""
    },
    {
      "key": "webhookUrl",
      "value": "https://example.com/watchdog-hook"
    },
    {
      "key": "channelId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Says the server is running\", function () { pm.expect(pm.response.json().success).to.eql(true); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Creates the account and logs you in. Rate limited to 10 attempts per 15 minutes."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Registered (201) or the email already exists (409)\", function () { pm.expect(pm.response.code).to.be.oneOf([201, 409]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Does not return the password\", function () { pm.expect(pm.response.json().user.password).to.be.undefined; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Returns the logged-in user\", function () { pm.expect(pm.response.json().user.email).to.eql(pm.collectionVariables.get(\"email\")); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Monitors",
      "item": [
        {
          "name": "Create monitor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/monitors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "monitors"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Example site\",\n  \"url\": \"{{targetUrl}}\",\n  \"method\": \"GET\",\n  \"intervalMinutes\": 1,\n  \"timeoutMs\": 10000,\n  \"expectedStatusCodes\": [\n    200\n  ],\n  \"keyword\": \"\",\n  \"failureThreshold\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Starts a first check straight away. Up to 20 monitors per account. In production, private and local addresses are refused."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Returns the new monitor without secrets\", function () { var m = pm.response.json().monitor; pm.expect(m.name).to.eql(\"Example site\"); pm.expect(m.encryptedHeaders).to.be.undefined; pm.collectionVariables.set(\"monitorId\", m._id); pm.collectionVariables.set(\"monitorUrl\", m.url); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List monitors",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/monitors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "monitors"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Each monitor carries recent checks and 24 hour uptime\", function () { var list = pm.response.json().monitors; pm.expect(list.length).to.be.above(0); pm.expect(list[0]).to.have.property(\"recentChecks\"); pm.expect(list[0]).to.have.property(\"uptime24h\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get one monitor",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/monitors/{{monitorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "monitors",
                "{{monitorId}}"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update monitor",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/monitors/{{monitorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "monitors",
                "{{monitorId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Example site (edited)\",\n  \"intervalMinutes\": 5,\n  \"failureThreshold\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Only the fields you send change. The URL can never be changed."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Saved the change and left the URL alone\", function () { var m = pm.response.json().monitor; pm.expect(m.name).to.eql(\"Example site (edited)\"); pm.expect(m.url).to.eql(pm.collectionVariables.get(\"monitorUrl\")); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Pause or resume",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/monitors/{{monitorId}}/toggle",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "monitors",
                "{{monitorId}}",
                "toggle"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Pause or resume again",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/monitors/{{monitorId}}/toggle",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "monitors",
                "{{monitorId}}",
                "toggle"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Check results",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/monitors/{{monitorId}}/results?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "monitors",
                "{{monitorId}}",
                "results"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Has results and 24 hour statistics\", function () { var body = pm.response.json(); pm.expect(body.results).to.be.an(\"array\"); pm.expect(body.last24h).to.have.property(\"checks\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Incidents of this monitor",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/monitors/{{monitorId}}/incidents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "monitors",
                "{{monitorId}}",
                "incidents"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Check now",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/monitors/{{monitorId}}/check",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "monitors",
                "{{monitorId}}",
                "check"
              ]
            },
            "description": "Limited to one check every 10 seconds per monitor."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Checked (200) or still in the 10 second cooldown (429)\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 429]); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Incidents",
      "item": [
        {
          "name": "List incidents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/incidents?status=all&page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "incidents"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "all"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "[\n  \"pm.test(\\\"Status is 200\\\", function () { pm.response.to.have.status(200); });\",\n  \"pm.test(\\\"Paginated list\\\", function () { var b = pm.response.json(); pm.expect(b.incidents).to.be.an(\\\"array\\\"); pm.expect(b).to.have.property(\\\"pages\\\"); if (b.incidents.length) { pm.collectionVariables.set(\\\"incidentId\\\", b.incidents[0]._id); } });\"\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "status can be active, open, acknowledged, resolved or all. limit is 1 to 50."
          },
          "response": []
        },
