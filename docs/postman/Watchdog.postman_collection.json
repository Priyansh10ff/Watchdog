            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Acknowledged (200), refused (400) or none exists (404)\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 400, 404]); });"
                ]
              }
            }
          ]
        }
      ]
    },
