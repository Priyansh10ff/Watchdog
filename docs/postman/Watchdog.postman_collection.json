            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Shows the limit and never an address or a secret\", function () { var body = pm.response.json(); pm.expect(body.limit).to.eql(3); pm.expect(body.channels).to.be.an(\"array\"); pm.expect(pm.response.text()).to.not.include(\"signingSecret\"); pm.expect(pm.response.text()).to.not.include('\"url\"'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Add alert channel",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/webhooks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "webhooks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman hook\",\n  \"format\": \"generic\",\n  \"url\": \"{{webhookUrl}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "format is slack, discord or generic. In production a Slack address must start with https://hooks.slack.com/services/ and a Discord address with https://discord.com/api/webhooks/. Up to 3 channels per account. The signing secret (generic channels) is returned only in this answer."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Hands out the signing secret once and hides the address\", function () { var body = pm.response.json(); pm.expect(body.signingSecret).to.match(/^[0-9a-f]{48}$/); pm.expect(body.channel).to.not.have.property(\"url\"); pm.expect(body.channel.urlPreview).to.be.a(\"string\"); pm.collectionVariables.set(\"channelId\", body.channel._id); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Pause alert channel",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/{{channelId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "webhooks",
                "{{channelId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
